        <bpmn:incoming>Flow_05t47xq</bpmn:incoming>
        <bpmn:outgoing>Flow_18lt8tq</bpmn:outgoing>
        <bpmn:script>reason = []

if cnt%2 == 0:
    valid = False
    reason.append("I didn't feel like it")
    reason_str = "I didn't feel like it"
else:
    valid = True
    reason_str = ""

# store result
record_valid[cnt] = {
    "valid": valid,
    "reason": reason,
    "reason_id": id(reason),
    "reason_copy": reason[:]
}

record_valid_a.append(record_valid[cnt])


# increment idx
cnt = cnt + 1</bpmn:script>
      </bpmn:scriptTask>
