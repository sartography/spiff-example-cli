    <bpmn:scriptTask id="Task_1764942097580" name="make array">
      <bpmn:incoming>Flow_1x0s7nh</bpmn:incoming>
      <bpmn:outgoing>Flow2_1764942097580</bpmn:outgoing>
      <bpmn:script>ar = [1,2,3,4,5,6]
